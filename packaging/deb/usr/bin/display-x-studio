#!/bin/sh
# Display X Studio wrapper script

APP_DIR="/opt/display-x-studio"

# Ensure dynamic linker finds bundled libraries before system search paths
export LD_LIBRARY_PATH="$APP_DIR/_internal/PyQt5/Qt5/lib:$APP_DIR/_internal:$APP_DIR/lib:$LD_LIBRARY_PATH"

# Set platform fallback order if not already specified by the user
if [ -z "$QT_QPA_PLATFORM" ]; then
    export QT_QPA_PLATFORM="xcb;wayland"
fi

exec "$APP_DIR/Display X Studio" "$@"
